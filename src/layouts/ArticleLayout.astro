---
/**
 * 文章详情模板（三栏）
 * 220 / 正文 / 220 —— 桌面三栏，平板两栏，手机单栏 + 折叠目录。
 * 页面只负责取数据与拼装，正文由 MDX 注入到 slot。
 */
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "../components/global/Breadcrumb.astro";
import Toc from "../components/nav/Toc.astro";
import TrustRow from "../components/content/TrustRow.astro";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  title: string;
  nameEn?: string;
  description?: string;
  summary?: string;
  categoryName?: string;
  categoryHref?: string;
  sourceLevel?: string;
  headings: Heading[];
  family?: { name: string; href: string; order: number; active: boolean }[];
  breadcrumb: { label: string; href?: string }[];
}

const {
  title,
  nameEn,
  description,
  summary,
  categoryName,
  categoryHref,
  sourceLevel,
  headings,
  family = [],
  breadcrumb,
} = Astro.props;
---

<BaseLayout title={title} description={description ?? summary} activePath="/methods/">
  <div class="mf-container pt-6">
    <Breadcrumb items={breadcrumb} />
  </div>

  <div class="mf-container pb-16 pt-6 md:pt-8">
    <div
      class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_180px] xl:grid-cols-[180px_minmax(0,1fr)_180px] xl:gap-12"
    >
      <!-- 左栏：同族方法 -->
      <aside class="hidden xl:block">
        <div class="sticky top-24">
          {
            family.length > 0 && (
              <nav aria-label="同族方法">
                <p class="mb-2.5 text-[11px] tracking-[0.08em] text-ink-4">同族方法</p>
                <ul class="space-y-0.5">
                  {family.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class:list={["flex items-baseline gap-2 border-l-2 py-1.5 pl-3 text-[12.5px] transition-colors duration-100", item.active ? "border-accent bg-accent-soft text-accent" : "border-line-soft text-ink-3 hover:border-accent hover:text-accent"]}
                        aria-current={item.active ? "page" : undefined}
                      >
                        <span class="font-mono text-[10px] text-ink-4">
                          {String(item.order).padStart(2, "0")}
                        </span>
                        <span class="leading-5">{item.name}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            )
          }
        </div>
      </aside>

      <!-- 正文 -->
      <article class="min-w-0">
        <header class="mf-enter border-b border-line pb-7">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
            {
              categoryName && (
                <a
                  href={categoryHref}
                  class="font-mono text-[11px] tracking-widest text-ink-4 transition-colors duration-100 hover:text-accent"
                >
                  {categoryName}
                </a>
              )
            }
          </div>

          <h1 class="mt-3 text-[32px] leading-[1.15] font-semibold tracking-[-0.015em] md:text-[40px]">
            {title}
          </h1>

          {nameEn && <p class="mt-2.5 font-mono text-[12.5px] tracking-wide text-ink-3">{nameEn}</p>}

          {
            summary && (
              <p class="mt-5 max-w-[60ch] text-[16px] leading-[1.85] text-ink-2">{summary}</p>
            )
          }

          <TrustRow class="mt-5" />

          <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-2 text-[12.5px]">
            {
              sourceLevel && (
                <div class="flex items-baseline gap-2">
                  <dt class="text-ink-4">来源级别</dt>
                  <dd class="text-ink-2">{sourceLevel}</dd>
                </div>
              )
            }
            {
              family.length > 0 && (
                <div class="flex items-baseline gap-2">
                  <dt class="text-ink-4">同族方法</dt>
                  <dd class="text-ink-2">{family.length} 项</dd>
                </div>
              )
            }
          </dl>
        </header>

        {/* 首屏层：定义之后立刻给「模型 + 四个带出处的参数」，深内容全部收在下方折叠区 */}
        {
          Astro.slots.has("hero") && (
            <div class="mt-6" data-reveal>
              <slot name="hero" />
            </div>
          )
        }

        <details class="mt-6 rounded-card border border-line bg-surface px-4 py-3 lg:hidden">
          <summary class="cursor-pointer text-[12.5px] text-ink-2">本文目录</summary>
          <div class="mt-3"><Toc headings={headings} maxDepth={3} /></div>
        </details>

        <div class="mf-prose mt-8">
          <slot />
        </div>
      </article>

      <!-- 右栏：目录 -->
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <Toc headings={headings} />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
