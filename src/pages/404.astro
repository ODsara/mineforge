---
/**
 * 404
 * 静态站点没有服务端兜底，404 页直接给全站导航，避免读者卡死在这里。
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { methodCategories, methodsOfCategory, engineeringTopics } from "../lib/taxonomy";
import { resourceTypes, resourceHref } from "../lib/resources";
---

<BaseLayout title="页面不存在" description="请求的页面不存在，可从站点主要入口继续浏览。">
  <section class="mf-container py-16 md:py-24">
    <p class="font-mono text-[11px] tracking-widest text-ink-4">ERROR 404</p>
    <h1 class="mt-3 text-[30px] leading-tight font-semibold tracking-[-0.01em] md:text-[40px]">
      这个页面不存在
    </h1>
    <p class="mf-measure mt-4 text-[14.5px] leading-7 text-ink-2">
      请检查访问地址，或通过搜索和下方的分类入口继续学习。
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="/"
        class="inline-flex h-10 items-center rounded-button bg-navy px-5 text-[13.5px] font-medium text-on-navy transition-colors duration-100 hover:bg-navy/90"
      >
        回到首页
      </a>
      <a
        href="/search/"
        class="inline-flex h-10 items-center rounded-button border border-line px-5 text-[13.5px] text-ink-2 transition-colors duration-100 hover:border-line-strong hover:text-ink"
      >
        搜索知识库
      </a>
    </div>

    <div class="mt-14 grid gap-x-10 gap-y-10 border-t border-line pt-10 md:grid-cols-3">
      <div>
        <h2 class="font-mono text-[10.5px] tracking-widest text-ink-4">采矿方法</h2>
        <ul class="mt-3 space-y-1">
          <li>
            <a href="/methods/" class="block py-1 text-[13px] text-ink-2 hover:text-accent">全部方法</a>
          </li>
          {
            methodCategories.map((category) => (
              <li>
                <a
                  href={`/methods/${category.slug}/`}
                  class="flex items-baseline justify-between gap-3 py-1 text-[13px] text-ink-2 hover:text-accent"
                >
                  {category.name}
                  <span class="font-mono text-[10.5px] text-ink-4">
                    {methodsOfCategory(category.slug).length}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-mono text-[10.5px] tracking-widest text-ink-4">工程技术</h2>
        <ul class="mt-3 space-y-1">
          {
            engineeringTopics.map((topic) => (
              <li>
                <a href={`/engineering/${topic.slug}/`} class="block py-1 text-[13px] text-ink-2 hover:text-accent">
                  {topic.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="font-mono text-[10.5px] tracking-widest text-ink-4">资料与项目</h2>
        <ul class="mt-3 space-y-1">
          <li>
            <a href="/knowledge/" class="block py-1 text-[13px] text-ink-2 hover:text-accent">知识体系</a>
          </li>
          {
            resourceTypes.map((type) => (
              <li>
                <a href={resourceHref(type.slug)} class="block py-1 text-[13px] text-ink-2 hover:text-accent">
                  {type.name}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/about/" class="block py-1 text-[13px] text-ink-2 hover:text-accent">关于 MineForge</a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
