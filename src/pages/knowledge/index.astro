---
/**
 * 知识体系总览
 * 分类树（左栏粘性）+ 六个方向的导读 + 推荐学习路径
 * 本页只做索引与导读，不承载专业正文
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/layout/PageHero.astro";
import SectionHeader from "../../components/layout/SectionHeader.astro";
import KnowledgeTree from "../../components/nav/KnowledgeTree.astro";
import taxonomy from "../../data/taxonomy.json";
import {
  domains,
  domainHref,
  engineeringHref,
  getDomain,
  relatedEngineering,
  siteStats,
} from "../../lib/taxonomy";

const stats = siteStats();
const path = taxonomy.learningPath;
---

<BaseLayout
  title="知识体系"
  description="采矿工程知识体系：按学科方向组织的分类树与学习路径，覆盖地下采矿方法、露天开采、矿床开拓与采准、通风与安全、机械运输、设计与数字化。"
  activePath="/knowledge/"
>
  <PageHero
    eyebrow="知识体系"
    title="采矿工程知识体系"
    description="从井筒、巷道和采场的空间关系入门，再学习采矿方法、通风运输与矿山设计。露天开采用于了解相关工艺和露天转地下的衔接。"
  >
    <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-3 text-[12.5px]">
      {
        stats.map((stat) => (
          <div class="flex items-baseline gap-1.5">
            <dd class="font-mono text-[15px] font-medium text-ink">{stat.value}</dd>
            <dt class="text-ink-4">
              {stat.unit}
              {stat.label}
            </dt>
          </div>
        ))
      }
    </dl>
  </PageHero>

  <div class="mf-container grid gap-10 py-12 lg:grid-cols-12 lg:gap-14 md:py-16">
    <aside class="lg:col-span-3">
      <div class="lg:sticky lg:top-24">
        <KnowledgeTree />
      </div>
    </aside>

    <div class="lg:col-span-9">
      <SectionHeader
        index="01 / 分类树"
        title="六个学科方向"
        description="每个方向给出定位、知识要点与对应的工程专题入口。地下采矿方法直接进入方法库。"
      />

      <div class="mt-8 space-y-0">
        {
          domains.map((domain) => {
            const related = relatedEngineering(domain);
            return (
              <article
                id={domain.slug}
                class="scroll-mt-24 border-t border-line py-8 first:border-t-0 first:pt-0"
              >
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="font-mono text-[11px] text-ink-4">
                    {String(domain.order).padStart(2, "0")}
                  </span>
                  <h2 class="text-[19px] font-semibold text-ink">{domain.name}</h2>
                  <span class="font-mono text-[11px] tracking-wide text-ink-4">
                    {domain.nameEn}
                  </span>
                </div>

                <p class="mt-3 max-w-2xl text-[13.5px] leading-7 text-ink-2">
                  {domain.summary}
                </p>

                <div class="mt-5 grid gap-6 sm:grid-cols-2">
                  <div>
                    <p class="text-[11px] tracking-[0.08em] text-ink-4">知识要点</p>
                    <ul class="mt-2.5 space-y-1.5">
                      {domain.topics.map((topic) => (
                        <li class="flex items-baseline gap-2 text-[13px] leading-6">
                          <span class="mt-2 h-[3px] w-[3px] shrink-0 rounded-full bg-line-strong" aria-hidden="true" />
                          {topic.href ? (
                            <a
                              href={topic.href}
                              class="text-ink-2 underline decoration-line-strong decoration-1 underline-offset-4 transition-colors duration-100 hover:text-accent hover:decoration-accent"
                            >
                              {topic.label}
                            </a>
                          ) : (
                            <span class="text-ink-2">{topic.label}</span>
                          )}
                          {!topic.href && (
                            <span class="rounded-card border border-line-soft px-1 py-px text-[10.5px] text-ink-3">
                              {topic.body?.length ? "知识要点" : ""}
                            </span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div>
                    <p class="text-[11px] tracking-[0.08em] text-ink-4">对应工程专题</p>
                    {related.length > 0 ? (
                      <ul class="mt-2.5 space-y-1.5">
                        {related.map((topic) => (
                          <li>
                            <a
                              href={engineeringHref(topic.slug)}
                              class="text-[13px] text-ink-2 underline decoration-line-strong decoration-1 underline-offset-4 transition-colors duration-100 hover:text-accent hover:decoration-accent"
                            >
                              {topic.name}
                            </a>
                            <span class="ml-2 text-[11.5px] text-ink-4">{topic.summary}</span>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p class="mt-2.5 text-[12.5px] leading-6 text-ink-4">
                        {domain.slug === "open-pit"
                          ? "在知识要点中阅读台阶开采与露天转地下。"
                          : domain.slug === "underground-mining"
                            ? "本方向直接进入采矿方法库，不单设工程专题。"
                            : "查看本方向的知识要点。"}
                      </p>
                    )}
                  </div>
                </div>

                <div class="mt-6">
                  <a
                    href={domainHref(domain)}
                    class="inline-flex items-center gap-1.5 text-[12.5px] text-accent transition-colors duration-100 hover:text-accent-strong"
                  >
                    {domain.slug === "underground-mining" ? "进入采矿方法库" : "查看方向详情"}
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>

  <section class="border-t border-line bg-surface" aria-labelledby="sec-path">
    <div class="mf-container py-14 md:py-20">
      <SectionHeader
        id="sec-path"
        index="02 / 学习路径"
        title="建议的学习顺序"
        description="从约束条件出发，先建立边界意识，再进入方法体系，最后落到设计与校核。"
      />

      <ol data-reveal="stagger" class="mt-9 grid gap-px overflow-hidden rounded-card border border-line bg-line md:grid-cols-3">
        {
          path.map((step, i) => (
            <li class="bg-bg p-6">
              <div class="flex items-baseline gap-2">
                <span class="font-mono text-[11px] text-accent">{step.stage}</span>
                <span class="font-mono text-[11px] text-ink-4">
                  {String(i + 1).padStart(2, "0")}
                </span>
              </div>
              <h3 class="mt-2 text-[16px] font-medium">{step.title}</h3>
              <p class="mt-2 text-[12.5px] leading-6 text-ink-3">{step.description}</p>
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {step.domains.map((slug) => {
                  const domain = getDomain(slug);
                  if (!domain) return null;
                  return (
                    <li>
                      <a
                        href={domainHref(domain)}
                        class="inline-block rounded-button border border-line-soft bg-surface px-2 py-[3px] text-[11.5px] text-ink-2 transition-colors duration-100 hover:border-accent/35 hover:text-accent"
                      >
                        {domain.name}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </li>
          ))
        }
      </ol>

    </div>
  </section>
</BaseLayout>
