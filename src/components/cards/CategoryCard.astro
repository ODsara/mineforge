---
/** 知识方向卡片：编号 + 名称 + 一句说明 + 知识点数量 */
import StatusDot from "../content/StatusDot.astro";
import { domainHref, type Domain } from "../../lib/taxonomy";

interface Props {
  domain: Domain;
}

const { domain } = Astro.props;
const href = domainHref(domain);
const linkedTopics = domain.topics.filter((t) => t.href).length;
---

<a
  href={href}
  class="group flex h-full flex-col rounded-card border border-line bg-bg p-5 transition-colors duration-200 hover:border-line-strong hover:bg-panel"
>
  <div class="flex items-start justify-between">
    <span class="font-mono text-[11px] tracking-wider text-ink-4">
      {String(domain.order).padStart(2, "0")}
    </span>
    <StatusDot status={domain.status} />
  </div>

  <h3
    class="mt-3 text-[15px] leading-6 font-medium text-ink transition-colors duration-100 group-hover:text-accent"
  >
    {domain.name}
  </h3>

  <p class="mt-2 line-clamp-3 flex-1 text-[12.5px] leading-6 text-ink-3">
    {domain.summary}
  </p>

  <div class="mt-4 flex items-center justify-between border-t border-line-soft pt-3">
    <span class="text-[11.5px] text-ink-4">
      {linkedTopics > 0 ? `${linkedTopics} 个知识点` : "知识点待补充"}
    </span>
    <span class="text-[11.5px] text-ink-4 transition-colors duration-100 group-hover:text-accent">
      {domain.slug === "underground-mining" ? "进入方法库" : "查看分类"} →
    </span>
  </div>
</a>
