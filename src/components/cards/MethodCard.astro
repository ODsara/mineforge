---
/**
 * 方法卡片（v2.1 设计审查后重做）
 *
 * 信息序：工程图缩略 → 方法名 → 分类路径 → 数字条（带来源徽章）→ 条件标签 → 一句话。
 * v2.1 关键改动：缩略图改用该方法真实的工程示意图（figures.json，每法至少一幅），
 * 不再用空占位网格——方法库从此是一部"工程图集"，而不是一排空盒子。
 * 渲染图（webp）走展台深色底 object-cover；线稿（svg）走纸底 object-contain。
 * 字号整体上抬：标题 16px、辅助 12px，达标且立得住层级。
 * 缺图条目才回落到图纸网格占位，不编数字、不填空白。
 */
import StatusDot from "../content/StatusDot.astro";
import SourceBadge from "../content/SourceBadge.astro";
import { parentMethod, categoryBySlug, figures, type Method } from "../../lib/taxonomy";
import { engineeringRecord, splitValue } from "../../lib/engineering";

interface Props {
  method: Method;
  href: string;
  showCategory?: boolean;
  categoryName?: string;
}

const { method, href, showCategory = false, categoryName = "" } = Astro.props;

const parent = parentMethod(method);
const category = categoryBySlug(method.category);
const record = engineeringRecord(method.slug);

/** 缩略图：优先渲染图，其次线稿；都取该方法的第一幅 */
const methodFigures = figures.filter((f) => f.method === method.slug);
const thumb =
  methodFigures.find((f) => f.kind === "render") ?? methodFigures[0] ?? null;
const isRender = thumb?.kind === "render";

/** 数字条：只取这两项——选型时最先看的两个量 */
const metric = (name: string) => {
  const hit = record?.parameters.find((p) => p.name === name);
  return hit ? { ...hit, ...splitValue(hit) } : null;
};
const SHORT: Record<string, string> = { 矿块生产能力: "矿块能力", 矿石损失率: "损失率" };
const metrics = [metric("矿块生产能力"), metric("矿石损失率")].filter(Boolean) as NonNullable<
  ReturnType<typeof metric>
>[];

/** 条件标签：来自 methods.json → conditions，与速查面板同一份数据 */
const LABEL: Record<string, Record<string, string>> = {
  dip: { lean: "缓倾", inclined: "倾斜", steep: "急倾" },
  thickness: { thin: "薄矿体", medium: "中厚", thick: "厚矿体" },
  rock: { stable: "围岩稳固", moderate: "围岩中等", poor: "围岩差" },
};
const tags = method.conditions
  ? (["dip", "thickness", "rock"] as const)
      .flatMap((k) => (method.conditions![k] ?? []).map((v) => LABEL[k][v]).filter(Boolean))
      .slice(0, 3)
  : [];
---

<a
  href={href}
  class="mf-lift group flex h-full flex-col overflow-hidden rounded-card border border-line bg-surface hover:border-line-strong hover:bg-panel"
>
  <!-- 工程图缩略：真实示意图，渲染图深底/线稿纸底 -->
  <div class:list={["relative aspect-[16/10] overflow-hidden border-b border-line", isRender ? "bg-stage" : "bg-panel"]}>
    {
      thumb ? (
        <img
          src={thumb.src}
          alt={`${method.name}工程示意图`}
          width={thumb.width}
          height={thumb.height}
          loading="lazy"
          decoding="async"
          class:list={["h-full w-full", isRender ? "object-cover" : "object-contain p-1.5"]}
        />
      ) : (
        <div class="mf-card-placeholder flex h-full flex-col items-center justify-center gap-1.5">
          <span class="font-mono text-[11px] tracking-[0.16em] text-ink-4">
            {method.nameEn.slice(0, 22).toUpperCase()}
          </span>
        </div>
      )
    }
    <span class="absolute top-2.5 right-2.5">
      <StatusDot status={method.status} />
    </span>
    {
      thumb && (
        <span class="absolute bottom-2 left-2.5 font-mono text-[10.5px] tracking-[0.12em] text-ink-4">
          {thumb.figureNo}
        </span>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-4">
    <div class="flex items-baseline gap-2">
      <span class="font-mono text-[11.5px] text-ink-4">{String(method.order).padStart(2, "0")}</span>
      <h3 class="mf-card-title text-[16px] leading-6 font-semibold text-ink transition-colors duration-150 group-hover:text-accent">
        {method.name}
      </h3>
    </div>

    <p class="mt-1 text-[12px] text-ink-3">
      {category?.name}
      {parent ? ` · ${parent.name}的变体` : ""}
      {showCategory && categoryName ? ` · ${categoryName}` : ""}
    </p>

    {
      metrics.length > 0 ? (
        <dl class="mt-3 grid grid-cols-2 gap-px overflow-hidden rounded-button border border-line bg-line">
          {metrics.map((m) => (
            <div class="bg-bg px-2.5 py-2">
              <dd class="flex items-baseline gap-1">
                <span class="font-mono text-[14px] leading-none font-semibold text-navy">
                  {m.main}
                </span>
                {m.unit && <span class="font-mono text-[10.5px] text-ink-3">{m.unit}</span>}
              </dd>
              <dt class="mt-1 flex flex-wrap items-center gap-1 text-[11px] text-ink-3">
                <span>{SHORT[m.name] ?? m.name}</span>
                <SourceBadge type={m.value_type} class="scale-90 origin-left" />
              </dt>
            </div>
          ))}
        </dl>
      ) : (
        <p class="mt-3 rounded-button border border-dashed border-line px-2.5 py-2 text-[11.5px] text-ink-4">
          参数待核对
        </p>
      )
    }

    {
      tags.length > 0 && (
        <ul class="mt-2.5 flex flex-wrap gap-1">
          {tags.map((t) => (
            <li class="rounded-button border border-line bg-bg px-1.5 py-[2px] text-[11px] text-ink-3">
              {t}
            </li>
          ))}
        </ul>
      )
    }

    <p class="mt-2.5 line-clamp-2 flex-1 text-[12.5px] leading-5 text-ink-3">{method.summary}</p>

    <span class="mt-3 flex items-center gap-1.5 border-t border-line-soft pt-2.5 text-[12px] text-ink-3 transition-colors duration-150 group-hover:text-accent">
      查看详情
      <svg class="mf-arrow" width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
  </div>
</a>