---
/**
 * 全局 Header
 * 64px 粘性顶栏 + 1px 分隔线，无阴影无模糊，滚动时保持实底
 */
import site from "../../data/site.json";
import BrandMark from "./BrandMark.astro";
import NavPrimary from "./NavPrimary.astro";
import NavMobile from "./NavMobile.astro";
import SearchTrigger from "./SearchTrigger.astro";

interface Props {
  activePath: string;
}

const { activePath } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-line bg-bg">
  <div class="mf-container flex h-16 items-center gap-6 xl:gap-10">
    <a
      href="/"
      class="flex shrink-0 items-center gap-2.5 rounded-button text-ink"
      aria-label={`${site.name} 首页`}
    >
      <span class="text-accent"><BrandMark size={22} /></span>
      <span class="text-[17px] font-semibold tracking-[-0.01em]">MineForge</span>
    </a>

    <NavPrimary activePath={activePath} />

    <div class="ml-auto flex items-center gap-2">
      <SearchTrigger />
      <button
        type="button"
        data-nav-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="打开导航"
        class="-mr-1.5 flex h-9 w-9 items-center justify-center rounded-button text-ink-2 hover:text-ink lg:hidden"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path
            d="M2.5 5h13M2.5 9h13M2.5 13h13"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <NavMobile activePath={activePath} />
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const panel = document.getElementById("mobile-nav");

  function setOpen(open: boolean) {
    if (!panel || !toggle) return;
    panel.dataset.open = String(open);
    panel.setAttribute("aria-hidden", String(!open));
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "关闭导航" : "打开导航");
    document.documentElement.style.overflow = open ? "hidden" : "";
    if (open) {
      panel.querySelector<HTMLElement>("[data-nav-close]")?.focus();
    }
  }

  toggle?.addEventListener("click", () => {
    const isOpen = panel?.dataset.open === "true";
    setOpen(!isOpen);
  });

  panel?.querySelectorAll<HTMLElement>("[data-nav-close]").forEach((el) => {
    el.addEventListener("click", () => setOpen(false));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && panel?.dataset.open === "true") {
      setOpen(false);
      toggle?.focus();
    }
  });

  // 断点回到桌面宽度时自动收起抽屉，避免滚动锁残留
  const desktop = window.matchMedia("(min-width: 1024px)");
  desktop.addEventListener("change", (event) => {
    if (event.matches) setOpen(false);
  });
</script>
