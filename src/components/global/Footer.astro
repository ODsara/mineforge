---
/** 全局 Footer：品牌说明 + 四列导航 + 内容声明 + 版本信息 */
import site from "../../data/site.json";
import BrandMark from "./BrandMark.astro";

const columns = site.footer.columns;
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-surface">
  <div class="mf-container py-14 md:py-16">
    <div class="grid grid-cols-12 gap-x-8 gap-y-10">
      <div class="col-span-12 lg:col-span-4">
        <div class="flex items-center gap-2.5">
          <span class="text-accent"><BrandMark size={20} /></span>
          <span class="text-[16px] font-semibold tracking-[-0.01em]">MineForge</span>
        </div>
        <p class="mt-4 max-w-xs text-[13px] leading-6 text-ink-3">
          {site.footer.note}
        </p>
      </div>

      {
        columns.map((column) => (
          <nav
            class="col-span-6 sm:col-span-3 lg:col-span-2"
            aria-label={column.title}
          >
            <h3 class="text-[12px] font-medium tracking-[0.08em] text-ink-3">
              {column.title}
            </h3>
            <ul class="mt-4 space-y-2.5">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[13px] text-ink-2 transition-colors duration-100 hover:text-accent"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-line pt-6 text-[12px] text-ink-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.footer.copyright}</p>
      <p class="font-mono tracking-tight">v{site.version} · 内容持续建设中</p>
    </div>
  </div>
</footer>
