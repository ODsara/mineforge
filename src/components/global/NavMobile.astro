---
/**
 * 移动端抽屉导航
 * 通过原生 dialog 展示菜单，开关由 Header.astro 管理
 */
import site from "../../data/site.json";
import { isActive } from "../../lib/nav";

interface Props {
  activePath: string;
}

const { activePath } = Astro.props;
const items = site.nav;
---

<dialog id="mobile-nav" aria-label="移动端菜单" class="flex-col bg-bg">

  <div class="flex h-16 shrink-0 items-center justify-between border-b border-line px-5">
    <span class="text-[15px] font-semibold tracking-tight">MineForge</span>
    <button
      type="button"
      data-nav-close
      autofocus
      class="-mr-2 flex h-10 w-10 items-center justify-center rounded text-ink-2 hover:text-ink"
      aria-label="关闭导航"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </div>

  <nav aria-label="移动端导航" class="flex-1 overflow-y-auto px-5 py-4">
    <ul class="divide-y divide-line-soft">
      {
        items.map((item) => {
          const active = isActive(activePath, item.href);
          return (
            <li>
              <a
                href={item.href}
                data-nav-close
                aria-current={active ? "page" : undefined}
                class:list={[
                  "flex items-baseline justify-between py-4 text-[16px]",
                  active ? "text-accent" : "text-ink",
                ]}
              >
                <span>{item.label}</span>
                {active && <span class="text-[12px] text-accent">当前</span>}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <div class="shrink-0 border-t border-line px-5 py-5">
    <p class="text-[12px] leading-6 text-ink-4">
      采矿工程知识平台 · v{site.version}
    </p>
  </div>
</dialog>

<style>
  #mobile-nav {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    color: var(--color-ink);
    translate: 0 14px;
    transition:
      translate var(--mf-d2) var(--mf-ease),
      display var(--mf-d2) allow-discrete,
      overlay var(--mf-d2) allow-discrete;
  }

  #mobile-nav[open] {
    display: flex;
    translate: 0;
  }

  @starting-style {
    #mobile-nav[open] {
      translate: 0 14px;
    }
  }

  #mobile-nav::backdrop {
    background: color-mix(in srgb, var(--color-ink) 20%, transparent);
  }

  @media (prefers-reduced-motion: no-preference) {
    #mobile-nav[open] nav li {
      animation: mf-ui-in var(--mf-d2) var(--mf-ease) both;
    }

    #mobile-nav[open] nav li:nth-child(2) { animation-delay: 30ms; }
    #mobile-nav[open] nav li:nth-child(3) { animation-delay: 60ms; }
    #mobile-nav[open] nav li:nth-child(4) { animation-delay: 90ms; }
    #mobile-nav[open] nav li:nth-child(5) { animation-delay: 120ms; }
    #mobile-nav[open] nav li:nth-child(6) { animation-delay: 150ms; }
  }
</style>
