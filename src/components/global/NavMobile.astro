---
/**
 * 移动端抽屉导航
 * 打开状态由 data-open 控制，交互脚本在 Header.astro 中，本组件只负责结构与样式
 */
import site from "../../data/site.json";
import { isActive } from "../../lib/nav";

interface Props {
  activePath: string;
}

const { activePath } = Astro.props;
const items = site.nav;
---

<div
  id="mobile-nav"
  data-open="false"
  aria-hidden="true"
  class="fixed inset-0 z-50 flex-col bg-bg lg:hidden"
>
  <div class="flex h-16 shrink-0 items-center justify-between border-b border-line px-5">
    <span class="text-[15px] font-semibold tracking-tight">MineForge</span>
    <button
      type="button"
      data-nav-close
      class="-mr-2 flex h-10 w-10 items-center justify-center rounded text-ink-2 hover:text-ink"
      aria-label="关闭导航"
    >
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"
        ></path>
      </svg>
    </button>
  </div>

  <nav aria-label="移动端导航" class="flex-1 overflow-y-auto px-5 py-4">
    <ul class="divide-y divide-line-soft">
      {
        items.map((item) => {
          const active = isActive(activePath, item.href);
          return (
            <li>
              <a
                href={item.href}
                data-nav-close
                aria-current={active ? "page" : undefined}
                class:list={[
                  "flex items-baseline justify-between py-4 text-[16px]",
                  active ? "text-accent" : "text-ink",
                ]}
              >
                <span>{item.label}</span>
                {active && <span class="text-[12px] text-accent">当前</span>}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>

  <div class="shrink-0 border-t border-line px-5 py-5">
    <p class="text-[12px] leading-6 text-ink-4">
      采矿工程知识平台 · v{site.version}
    </p>
  </div>
</div>

<style>
  #mobile-nav {
    display: none;
  }
  #mobile-nav[data-open="true"] {
    display: flex;
  }
</style>
