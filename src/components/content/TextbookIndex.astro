---
/** 推荐教材：区分「已入库」与「仅核书目」，避免把参考书目当成已读过的书 */
import { textbooks } from "../../lib/resources";

const yes = textbooks.filter((b) => b.verified);
const no = textbooks.filter((b) => !b.verified);
---

<div class="space-y-10">
  {
    [
      { title: "书目已核对", note: "版次、出版社与 ISBN 已确认，可直接引用", items: yes },
      { title: "待补书目信息", note: "仅知书名与用途，版次或页码未确认，暂不作为引用来源", items: no },
    ].map((group) => (
      <section>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-line pb-2">
          <h2 class="text-[14px] font-medium text-ink">{group.title}</h2>
          <span class="text-[11.5px] text-ink-4">
            {group.note} · {group.items.length} 本
          </span>
        </div>

        <ul class="mt-4 grid gap-4 md:grid-cols-2">
          {group.items.map((book) => (
            <li class="flex h-full flex-col rounded-card border border-line bg-bg p-5">
              <div class="flex items-start justify-between gap-3">
                <h3 class="text-[14.5px] leading-6 font-medium text-ink">{book.title}</h3>
                <span class="shrink-0 rounded-card border border-line px-1.5 py-0.5 text-[10.5px] text-ink-3">
                  {book.status}
                </span>
              </div>

              <p class="mt-1.5 text-[11.5px] leading-5 text-ink-4">
                {book.edition}
                {book.authors.length > 0 && ` · ${book.authors.join("、")}`}
              </p>

              <dl class="mt-3 space-y-1.5 text-[11.5px]">
                <div class="flex gap-2">
                  <dt class="w-14 shrink-0 text-ink-4">出版</dt>
                  <dd class="text-ink-2">
                    {book.publisher}
                    {book.year && `，${book.year}`}
                    {book.pages && `，${book.pages}`}
                  </dd>
                </div>
                {book.isbn && (
                  <div class="flex gap-2">
                    <dt class="w-14 shrink-0 text-ink-4">ISBN</dt>
                    <dd class="font-mono text-ink-2">{book.isbn}</dd>
                  </div>
                )}
                <div class="flex gap-2">
                  <dt class="w-14 shrink-0 text-ink-4">范围</dt>
                  <dd class="leading-5 text-ink-2">{book.scope}</dd>
                </div>
              </dl>

              <p class="mt-3 border-t border-line-soft pt-2.5 text-[11px] leading-5 text-ink-4">
                {book.note}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
