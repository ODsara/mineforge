---
/**
 * 内容状态说明块
 * 骨架阶段用来交代「这一页有什么、还缺什么、缺的部分怎么补」，
 * 取代早期带轮次文案的 ConstructionNote：对外页面不该出现内部排期。
 */
import StatusDot from "./StatusDot.astro";
import type { ContentStatus } from "../../lib/taxonomy";

interface Props {
  status?: ContentStatus;
  title?: string;
  items?: string[];
  note?: string;
}

const { status, title = "本页内容状态", items = [], note } = Astro.props;
---

<div class="rounded-card border border-line bg-surface">
  <div class="border-l-2 border-accent px-6 py-5">
    <div class="flex flex-wrap items-baseline gap-3">
      <h2 class="text-[14px] font-medium text-ink">{title}</h2>
      {status && <StatusDot status={status} />}
    </div>

    {
      items.length > 0 && (
        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          {items.map((item) => (
            <li class="flex items-start gap-2 text-[13px] leading-6 text-ink-2">
              <span
                class="mt-2.5 inline-block h-[3px] w-[3px] shrink-0 rounded-full bg-ink-4"
                aria-hidden="true"
              />
              {item}
            </li>
          ))}
        </ul>
      )
    }

    {
      note && (
        <p class="mt-4 border-t border-line pt-4 text-[12px] leading-6 text-ink-4">{note}</p>
      )
    }
  </div>
</div>
