---
/**
 * 公式与参数库
 * 三块内容：公式（只收定义式与力学平衡式）、参数（跨方法汇总，按来源性质分组）、待收录清单。
 * 参数分组顺序固定为 教材值 / 规范值 / 设计值 / 实测值 / 国际实践值，不同性质的数字不混排。
 */
import katex from "katex";
import { parameterGroups, formulas, plannedFormulas, formulaIntro } from "../../lib/resources";

const groups = parameterGroups;
const total = groups.reduce((n, g) => n + g.items.length, 0);

/**
 * LaTeX 在构建期渲染成静态 HTML + MathML：
 * 浏览器不需要加载 KaTeX 的 JS，公式也不会在首屏后「跳」一下。
 * throwOnError 关掉，写错的 TeX 会以红字显示而不是让整页构建失败。
 */
const tex = (src: string, displayMode = false) =>
  katex.renderToString(src, {
    displayMode,
    throwOnError: false,
    strict: "ignore",
    output: "htmlAndMathml",
  });
---

<div class="space-y-12">
  <div class="grid gap-3 sm:grid-cols-3">
    {
      [
        { label: "公式", value: formulas.length, unit: "条", hint: "定义式与力学平衡式" },
        { label: "已核对参数", value: total, unit: "条", hint: `${groups.length} 组来源类型` },
        { label: "待收录", value: plannedFormulas.length, unit: "项", hint: "含经验系数，须核原文" },
      ].map((item) => (
        <div class="rounded-card border border-line bg-surface px-4 py-3">
          <p class="text-[11.5px] text-ink-4">{item.label}</p>
          <p class="mt-1 flex items-baseline gap-1">
            <span class="font-mono text-[20px] leading-none font-medium text-ink">{item.value}</span>
            <span class="text-[11px] text-ink-4">{item.unit}</span>
          </p>
          <p class="mt-1.5 text-[10.5px] text-ink-4">{item.hint}</p>
        </div>
      ))
    }
  </div>

  <section>
    <div class="flex items-baseline justify-between gap-4 border-b border-line pb-2">
      <h2 class="text-[14px] font-medium text-ink">公式</h2>
      <span class="font-mono text-[11px] text-ink-4">{formulas.length} 条</span>
    </div>
    <p class="mt-3 max-w-3xl text-[12.5px] leading-6 text-ink-3">{formulaIntro}</p>

    <div class="mt-5 grid gap-4 lg:grid-cols-2">
      {
        formulas.map((f) => (
          <article class="flex h-full flex-col rounded-card border border-line bg-bg p-5">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="text-[14px] font-medium text-ink">{f.name}</h3>
              <span class="shrink-0 rounded-card border border-line px-1.5 py-0.5 text-[10.5px] text-ink-3">
                {f.kind}
              </span>
            </div>

            <div class="mf-formula mt-3 overflow-x-auto rounded-card border border-line bg-surface px-4 py-3">
              <span set:html={tex(f.tex, true)} />
            </div>

            <dl class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5">
              {f.vars.map((v) => (
                <div class="flex items-baseline gap-1.5">
                  <dt class="mf-formula-sym text-[11.5px] text-accent" set:html={tex(v.sym)}></dt>
                  <dd class="text-[11px] text-ink-4">
                    {v.name}
                    {v.unit !== "—" && ` / ${v.unit}`}
                  </dd>
                </div>
              ))}
            </dl>

            <p class="mt-3 flex-1 border-t border-line-soft pt-2.5 text-[11.5px] leading-6 text-ink-3">
              {f.note}
            </p>
            <p class="mt-1.5 text-[10.5px] text-ink-4">依据：{f.source}</p>
          </article>
        ))
      }
    </div>
  </section>

  {
    groups.map((group) => (
      <section>
        <div class="mb-3 flex items-baseline justify-between gap-4 border-b border-line pb-2">
          <h2 class="text-[14px] font-medium text-ink">{group.type}</h2>
          <span class="font-mono text-[11px] text-ink-4">{group.items.length} 条</span>
        </div>
        <div class="overflow-x-auto rounded-card border border-line">
          <table class="w-full min-w-[760px] border-collapse text-left">
            <caption class="sr-only">{group.type}参数表</caption>
            <thead>
              <tr class="bg-surface text-[11px] tracking-wide text-ink-4">
                <th scope="col" class="border-b border-line px-3 py-2 font-normal">参数</th>
                <th scope="col" class="border-b border-line px-3 py-2 font-normal">取值</th>
                <th scope="col" class="border-b border-line px-3 py-2 font-normal">所属方法</th>
                <th scope="col" class="border-b border-line px-3 py-2 font-normal">条件与说明</th>
                <th scope="col" class="border-b border-line px-3 py-2 font-normal">出处</th>
              </tr>
            </thead>
            <tbody>
              {group.items.map((p) => (
                <tr class="border-b border-line-soft align-top last:border-b-0 hover:bg-surface">
                  <th scope="row" class="px-3 py-2.5 text-left text-[12.5px] font-normal text-ink">
                    {p.name}
                  </th>
                  <td class="px-3 py-2.5 font-mono text-[12px] whitespace-nowrap text-ink">
                    {p.value}
                    {p.unit && p.unit !== "—" && (
                      <span class="ml-0.5 text-[10.5px] text-ink-4">{p.unit}</span>
                    )}
                  </td>
                  <td class="px-3 py-2.5 text-[11.5px] text-ink-3">{p.methodName}</td>
                  <td class="px-3 py-2.5 text-[11.5px] leading-5 text-ink-4">
                    {p.condition ?? p.note ?? "—"}
                  </td>
                  <td class="px-3 py-2.5 font-mono text-[10.5px] whitespace-nowrap text-ink-4">
                    {p.source}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))
  }

  <section>
    <div class="flex items-baseline justify-between gap-4 border-b border-line pb-2">
      <h2 class="text-[14px] font-medium text-ink">待收录：含经验系数的公式</h2>
      <span class="font-mono text-[11px] text-ink-4">{plannedFormulas.length} 项</span>
    </div>
    <p class="mt-2 max-w-2xl text-[12px] leading-6 text-ink-4">
      这类公式的系数来自回归分析、试验统计或规程条文，脱离原文使用等于伪造依据。核对到具体文献与页码后再入库。
    </p>
    <ul class="mt-4 divide-y divide-line border-y border-line">
      {
        plannedFormulas.map((f) => (
          <li class="grid gap-x-6 gap-y-1 py-3 md:grid-cols-12">
            <span class="text-[13px] text-ink md:col-span-3">{f.name}</span>
            <span class="text-[12px] leading-6 text-ink-4 md:col-span-7">{f.use}</span>
            <span class="text-[11px] text-ink-4 md:col-span-2 md:text-right">待核对</span>
          </li>
        ))
      }
    </ul>
  </section>
</div>
