---
/**
 * 方法速查（M-08 件 1）—— 3 秒层的新主角
 *
 * 三个下拉：倾角 / 厚度 / 围岩稳固 → 纯前端过滤 → 候选方法卡。
 *
 * 数据纪律：只有 methods.json 里带 conditions 的方法才进候选池。
 * conditions 是从 data/engineering/{slug}.json → applicability 逐条对照出来的枚举，
 * 不是另编一套适用条件。没有 conditions 的方法宁可不出结果，也不拿未核对的草稿条件当推荐依据。
 */
import { methods, methodHref, categoryBySlug } from "../../lib/taxonomy";

const DIP = [
  { v: "lean", label: "缓倾", hint: "< 30°" },
  { v: "inclined", label: "倾斜", hint: "30–55°" },
  { v: "steep", label: "急倾", hint: "> 55°" },
];
const THICK = [
  { v: "thin", label: "薄", hint: "< 5 m" },
  { v: "medium", label: "中厚", hint: "5–20 m" },
  { v: "thick", label: "厚", hint: "> 20 m" },
];
const ROCK = [
  { v: "stable", label: "稳固", hint: "可大暴露" },
  { v: "moderate", label: "中等", hint: "需支护" },
  { v: "poor", label: "差", hint: "易崩落" },
];

const eligible = methods.filter((m) => m.conditions);
const payload = {
  total: methods.length,
  items: eligible.map((m) => ({
    name: m.name,
    href: methodHref(m),
    path: categoryBySlug(m.category)?.name ?? "",
    blurb: m.summary,
    status: m.status,
    dip: m.conditions!.dip,
    thickness: m.conditions!.thickness,
    rock: m.conditions!.rock,
  })),
};
---

<section
  class="rounded-card border border-line bg-surface"
  data-quickmatch
  aria-labelledby="qm-title"
>
  <details class="mf-qm">
    <summary class="mf-qm__summary lg:hidden">
      <span class="text-[13.5px] font-medium text-navy">按矿体条件找方法</span>
      <svg class="mf-qm__chev" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
        <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </summary>

    <div class="mf-qm__body">
      <div class="flex items-baseline justify-between gap-3 border-b border-line px-5 py-3.5">
        <h2 id="qm-title" class="mf-card-title max-lg:sr-only text-[13.5px] font-semibold text-navy">
          按矿体条件找方法
        </h2>
        <button
          type="button"
          data-qm-reset
          class="rounded-button px-1.5 py-0.5 text-[12px] text-ink-4 transition-colors duration-150 hover:text-ink"
        >
          重置
        </button>
      </div>

      <div class="grid gap-3 px-5 py-4 sm:grid-cols-3">
        {
          [
            { key: "dip", label: "矿体倾角", options: DIP },
            { key: "thickness", label: "矿体厚度", options: THICK },
            { key: "rock", label: "围岩稳固性", options: ROCK },
          ].map((field) => (
            <label class="block">
              <span class="mb-1.5 block text-[11.5px] text-ink-3">{field.label}</span>
              <select
                data-qm-key={field.key}
                class="h-9 w-full rounded-button border border-line bg-bg px-2.5 text-[12.5px] text-ink focus:border-accent focus:outline-none"
              >
                <option value="">不限</option>
                {field.options.map((o) => (
                  <option value={o.v}>
                    {o.label} · {o.hint}
                  </option>
                ))}
              </select>
            </label>
          ))
        }
      </div>

      <div class="hidden border-t border-line px-5 py-4" data-qm-results>
        <ul class="space-y-2" data-qm-list></ul>
      </div>
    </div>
  </details>

  <script type="application/json" data-qm-data set:html={JSON.stringify(payload)} />
</section>

<script>
  type Item = {
    name: string;
    href: string;
    path: string;
    blurb: string;
    status: string;
    dip: string[];
    thickness: string[];
    rock: string[];
  };

  const root = document.querySelector<HTMLElement>("[data-quickmatch]");
  if (root) {
    // 桌面端始终展开。用脚本设置 open，而不是靠 CSS 覆盖——
    // 新版 Chromium 把 details 的收起实现为 content-visibility，作者样式盖不住。
    const shell = root.querySelector<HTMLDetailsElement>("details.mf-qm");
    const wide = window.matchMedia("(min-width: 1024px)");
    const syncOpen = () => {
      if (!shell) return;
      if (wide.matches) shell.open = true;
    };
    syncOpen();
    wide.addEventListener("change", syncOpen);


    const raw = root.querySelector<HTMLScriptElement>("[data-qm-data]")?.textContent ?? "{}";
    const data = JSON.parse(raw) as { total: number; items: Item[] };
    const selects = [...root.querySelectorAll<HTMLSelectElement>("[data-qm-key]")];
    const list = root.querySelector<HTMLElement>("[data-qm-list]")!;
    const results = root.querySelector<HTMLElement>("[data-qm-results]")!;
    const reset = root.querySelector<HTMLButtonElement>("[data-qm-reset]")!;

    const pick = () => {
      const map: Record<string, string> = {};
      for (const s of selects) if (s.value) map[s.dataset.qmKey!] = s.value;
      return map;
    };

    const render = () => {
      const cond = pick();
      const keys = Object.keys(cond);

      if (keys.length === 0) {
        list.innerHTML = "";
        results.classList.add("hidden");
        return;
      }

      const hits = data.items.filter(
        (it) =>
          (!cond.dip || it.dip.includes(cond.dip)) &&
          (!cond.thickness || it.thickness.includes(cond.thickness)) &&
          (!cond.rock || it.rock.includes(cond.rock))
      );

      results.classList.remove("hidden");

      if (hits.length === 0) {
        list.innerHTML =
          '<li class="mf-feedback-in rounded-button border border-dashed border-line-strong bg-bg px-3.5 py-3">' +
          '<p class="text-[12.5px] font-medium text-ink-2">没有符合全部所选条件的方法</p></li>';
        return;
      }

      list.innerHTML = hits
        .map(
          (it) =>
            `<li class="mf-feedback-in"><a href="${it.href}" class="group block rounded-button border border-line bg-bg px-3.5 py-3 transition-colors duration-150 hover:border-line-strong hover:bg-panel">` +
            `<div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">` +
            `<span class="mf-card-title text-[13.5px] font-semibold text-ink group-hover:text-accent">${it.name}</span>` +
            `<span class="font-mono text-[11px] text-ink-4">${it.path}</span>` +
            `</div>` +
            `<p class="mt-1 text-[12.5px] leading-6 text-ink-3">${it.blurb}</p>` +
            `</a></li>`
        )
        .join("");
    };

    selects.forEach((s) => s.addEventListener("change", render));
    reset.addEventListener("click", () => {
      selects.forEach((s) => (s.value = ""));
      render();
    });
    render();
  }
</script>

<style>
  /* 窄屏：一行折叠；桌面：始终展开（用作者样式覆盖 UA 对 details 的隐藏） */
  .mf-qm__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    cursor: pointer;
    list-style: none;
  }
  .mf-qm__summary::-webkit-details-marker {
    display: none;
  }
  .mf-qm__chev {
    color: var(--color-ink-3);
    transition: transform 0.18s ease;
  }
  .mf-qm[open] .mf-qm__chev {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .mf-qm__chev {
      transition: none;
    }
  }

  @media (min-width: 1024px) {
    .mf-qm__summary {
      display: none;
    }
    .mf-qm:not([open]) > .mf-qm__body {
      display: block;
    }
  }
</style>
