---
/**
 * 方法速查对比表
 * 只使用已结构化字段（名称 / 英文 / 大类 / 关系 / 状态）。
 * 参数级对比（阶段高、矿房尺寸、损失贫化等）必须逐条核对教材后才能进表，
 * 现阶段不填，避免出现无来源数字。
 */
import StatusDot from "./StatusDot.astro";
import { methodIndexRows } from "../../lib/taxonomy";

const rows = methodIndexRows();
---

<div class="overflow-x-auto rounded-card border border-line">
  <table class="w-full min-w-[680px] border-collapse text-left">
    <caption class="sr-only">采矿方法速查对比表</caption>
    <thead>
      <tr class="bg-surface text-[11px] tracking-wide text-ink-4">
        <th scope="col" class="border-b border-line px-4 py-2.5 font-normal">方法</th>
        <th scope="col" class="border-b border-line px-4 py-2.5 font-normal">英文名称</th>
        <th scope="col" class="border-b border-line px-4 py-2.5 font-normal">所属大类</th>
        <th scope="col" class="border-b border-line px-4 py-2.5 font-normal">关系</th>
        <th scope="col" class="border-b border-line px-4 py-2.5 text-right font-normal">状态</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map(({ method, categoryName, relation, href }) => (
          <tr class="border-b border-line-soft last:border-b-0 hover:bg-surface">
            <th scope="row" class="px-4 py-3 text-left text-[13px] font-normal">
              <a
                href={href}
                class="text-ink transition-colors duration-100 hover:text-accent"
              >
                {method.name}
              </a>
            </th>
            <td class="px-4 py-3 font-mono text-[11px] text-ink-3">{method.nameEn}</td>
            <td class="px-4 py-3 text-[12.5px] text-ink-2">{categoryName}</td>
            <td class="px-4 py-3 text-[12px] text-ink-3">{relation}</td>
            <td class="px-4 py-3 text-right">
              <StatusDot status={method.status} />
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<p class="mt-3 text-[12px] leading-6 text-ink-4">
  参数级对比（阶段高度、矿房尺寸、损失率与贫化率等）需要逐条核对教材与工程实例，核实前不列入本表，以免出现无来源数字。
</p>
