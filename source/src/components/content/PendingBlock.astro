---
/**
 * 待补充区块
 * 用于正文中「结构已定、内容未核」的段落（三维模型、工程示意图、工程案例）。
 * 与 StatusNote 的区别：StatusNote 是整页状态说明，本组件是正文流里的单段占位，
 * 尺寸恒定、不加动画，插入正文不会引起阅读节奏断裂。
 */
interface Props {
  label?: string;
  title?: string;
  text: string;
  items?: string[];
}

const { label, title, text, items = [] } = Astro.props;
---

<div class="not-prose my-6 rounded-card border border-dashed border-line-strong bg-surface/60 px-5 py-4">
  {
    label && (
      <p class="font-mono text-[10.5px] tracking-widest text-ink-4">{label}</p>
    )
  }
  {title && <p class="mt-1.5 text-[13.5px] font-medium text-ink">{title}</p>}
  <p class="mt-1.5 text-[12.5px] leading-6 text-ink-3">{text}</p>
  {
    items.length > 0 && (
      <ul class="mt-2.5 flex flex-wrap gap-x-4 gap-y-1">
        {items.map((item) => (
          <li class="text-[11.5px] text-ink-4">· {item}</li>
        ))}
      </ul>
    )
  }
</div>
