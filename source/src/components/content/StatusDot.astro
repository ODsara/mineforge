---
/** 内容状态胶囊：全站唯一的四态解释处，样式取自 tokens.css 的状态色 */
import { statusMeta, type ContentStatus } from "../../lib/taxonomy";

interface Props {
  status: ContentStatus;
  class?: string;
}

const { status, class: className = "" } = Astro.props;
// 数据层兜底：未知状态按「建设中」渲染，避免脏数据导致整页崩溃
const meta = statusMeta[status] ?? statusMeta.planned;
---

<span
  class:list={[
    "inline-flex items-center rounded-full border px-2 py-[2px] text-[11px] leading-4 whitespace-nowrap",
    meta.chip,
    className,
  ]}
>
  {meta.label}
</span>
