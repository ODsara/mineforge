---
/**
 * 开采工序链路
 * 七个工程专题不是平级的一排内容：前四个是沿时间推进的工序，后三个贯穿全过程。
 * 用一张链路图把这条关系画出来，读者才不会把「矿山通风」当成最后一步。
 */
import { engineeringTopics } from "../../lib/taxonomy";

const stepSlugs = ["development", "preparation-cutting", "stoping", "haulage"];
const spanSlugs = ["ventilation", "safety", "mine-design"];

const steps = stepSlugs
  .map((s) => engineeringTopics.find((t) => t.slug === s)!)
  .filter(Boolean);
const spans = spanSlugs
  .map((s) => engineeringTopics.find((t) => t.slug === s)!)
  .filter(Boolean);
---

<div class="rounded-card border border-line bg-bg">
  <div class="border-b border-line px-5 py-3">
    <p class="font-mono text-[10.5px] tracking-widest text-ink-4">PROCESS CHAIN</p>
    <p class="mt-1 text-[12.5px] text-ink-3">
      前四项按施工顺序推进，后三项贯穿全过程——每一步都要做通风、安全与设计的校核。
    </p>
  </div>

  <ol class="grid divide-y divide-line sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-4">
    {
      steps.map((topic, i) => (
        <li class="group relative border-line sm:border-r sm:last:border-r-0">
          <a
            href={`/engineering/${topic.slug}/`}
            class="flex h-full flex-col px-5 py-4 transition-colors duration-100 hover:bg-surface"
          >
            <span class="flex items-baseline gap-2">
              <span class="font-mono text-[11px] text-ink-4">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="text-[14px] font-medium text-ink group-hover:text-accent">
                {topic.name}
              </span>
            </span>
            <span class="mt-1.5 line-clamp-2 text-[11.5px] leading-5 text-ink-4">
              {topic.scope
                .slice(0, 2)
                .map((s) => s.label)
                .join(" · ")}
            </span>
          </a>
          {i < steps.length - 1 && (
            <svg
              class="absolute top-1/2 -right-[5px] hidden -translate-y-1/2 text-line-strong lg:block"
              width="10"
              height="10"
              viewBox="0 0 10 10"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M1 5h8M6 2l3 3-3 3"
                stroke="currentColor"
                stroke-width="1.1"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          )}
        </li>
      ))
    }
  </ol>

  <div class="border-t border-line bg-surface px-5 py-3">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <span class="font-mono text-[10.5px] tracking-widest text-ink-4">贯穿全过程</span>
      {
        spans.map((topic) => (
          <a
            href={`/engineering/${topic.slug}/`}
            class="group inline-flex items-center gap-1.5 rounded-button border border-line bg-bg px-2.5 py-1 text-[12px] text-ink-2 transition-colors duration-100 hover:border-accent hover:text-accent"
          >
            {topic.name}
          </a>
        ))
      }
    </div>
  </div>
</div>
