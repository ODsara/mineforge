---
/** 工程图解卡片：图号 + 图 + 图注 + 来源标注，来源永远与图同框 */
import type { Figure } from "../../lib/taxonomy";

interface Props {
  figure: Figure;
  size?: "lg" | "sm";
}

const { figure, size = "sm" } = Astro.props;
---

<figure id={figure.id} class="mf-lift group flex h-full flex-col overflow-hidden rounded-card border border-line bg-surface hover:border-line-strong scroll-mt-28">
  <a href={figure.src} aria-label={`查看原图：${figure.title}`} class:list={["relative block overflow-hidden", figure.kind === "render" ? "bg-stage" : "bg-panel"]}>
    <img
      src={figure.src}
      width={figure.width}
      height={figure.height}
      alt={figure.title + "：" + figure.caption}
      loading="lazy"
      decoding="async"
      class="aspect-[4/3] h-full w-full object-contain p-1.5"
    />
  </a>

  <figcaption class="flex flex-1 flex-col border-t border-line p-4">
    <h3 class="mf-card-title text-[14.5px] font-medium text-ink transition-colors duration-150 group-hover:text-accent">{figure.title}</h3>
    <p
      class:list={[
        "mt-1.5 flex-1 text-ink-3",
        size === "lg" ? "text-[13px] leading-6" : "line-clamp-2 text-[12.5px] leading-5",
      ]}
    >
      {figure.caption}
    </p>
    <p
      class="mt-3 flex items-center justify-between gap-3 border-t border-line-soft pt-2 text-[11.5px] text-ink-3"
    >
      <span class="font-mono tracking-wider text-accent">{figure.figureNo}</span>
      <span class="text-right">{figure.source}</span>
    </p>
  </figcaption>
</figure>
