---
/**
 * 站点 Logo 标记：竖井断面线稿（拱形 + 分层线）
 * 纯线条，不使用渐变或填充，与工程技术文档气质一致
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 22, class: className = "" } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 22 22"
  fill="none"
  class={className}
  aria-hidden="true"
  focusable="false"
>
  <path
    d="M3.25 19V9.75a7.75 7.75 0 0 1 15.5 0V19"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="square"
  ></path>
  <path d="M3.25 14.25h15.5" stroke="currentColor" stroke-width="1.6"></path>
  <path
    d="M8.75 19v-6.5a2.25 2.25 0 0 1 4.5 0V19"
    stroke="currentColor"
    stroke-width="1.2"
    opacity="0.5"
  ></path>
</svg>
