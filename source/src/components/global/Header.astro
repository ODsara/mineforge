---
/**
 * 全局 Header
 * 64px 粘性顶栏 + 1px 分隔线，无阴影无模糊，滚动时保持实底
 */
import site from "../../data/site.json";
import BrandMark from "./BrandMark.astro";
import NavPrimary from "./NavPrimary.astro";
import NavMobile from "./NavMobile.astro";
import SearchTrigger from "./SearchTrigger.astro";

interface Props {
  activePath: string;
}

const { activePath } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-line bg-bg">
  <div class:list={["mf-container flex h-16 items-center gap-6 xl:gap-10", activePath === "/" && "home-header"]}>
    <a
      href="/"
      class="flex shrink-0 items-center gap-2.5 rounded-button text-ink"
      aria-label={`${site.name} 首页`}
    >
      <span class="text-accent"><BrandMark size={22} /></span>
      <span class="text-[17px] font-semibold tracking-[-0.01em]">MineForge</span>
    </a>

    <NavPrimary activePath={activePath} />

    <div class="ml-auto flex items-center gap-2">
      <SearchTrigger />
      <button
        type="button"
        data-nav-toggle
        aria-haspopup="dialog"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="打开导航"
        class="-mr-1.5 flex h-9 w-9 items-center justify-center rounded-button text-ink-2 hover:text-ink lg:hidden"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path
            d="M2.5 5h13M2.5 9h13M2.5 13h13"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <NavMobile activePath={activePath} />
</header>

<style>
  .home-header {
    max-width: var(--mf-container-wide);
  }

  @media (min-width: 64rem) {
    .home-header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const panel = document.querySelector<HTMLDialogElement>("#mobile-nav");

  if (toggle && panel) {
    const desktop = window.matchMedia("(min-width: 1024px)");

    toggle.addEventListener("click", () => {
      if (panel.open || desktop.matches) return;
      panel.showModal();
      toggle.setAttribute("aria-expanded", "true");
      document.documentElement.classList.add("mf-nav-open");
    });

    panel.addEventListener("close", () => {
      toggle.setAttribute("aria-expanded", "false");
      document.documentElement.classList.remove("mf-nav-open");
      if (!desktop.matches) toggle.focus();
    });

    panel.querySelectorAll<HTMLElement>("[data-nav-close]").forEach((element) => {
      element.addEventListener("click", () => panel.close());
    });

    desktop.addEventListener("change", ({ matches }) => {
      if (matches && panel.open) panel.close();
    });
  }
</script>
