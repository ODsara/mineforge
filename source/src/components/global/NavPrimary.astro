---
/**
 * 桌面主导航
 * 选中态：文字转主色 + 顶部栏底部 2px 指示条，不做位移与放大
 */
import site from "../../data/site.json";
import { isActive } from "../../lib/nav";

interface Props {
  activePath: string;
}

const { activePath } = Astro.props;
const items = site.nav;
---

<nav aria-label="主导航" class="hidden items-center gap-1 lg:flex">
  {
    items.map((item) => {
      const active = isActive(activePath, item.href);
      return (
        <a
          href={item.href}
          aria-current={active ? "page" : undefined}
          class:list={[
            "relative flex h-16 items-center px-3 text-[14px] transition-colors duration-100",
            active ? "font-medium text-navy" : "text-ink-2 hover:text-ink",
          ]}
        >
          {item.label}
          <span
            aria-hidden="true"
            class:list={[
              "pointer-events-none absolute inset-x-2 bottom-0 h-[2px]",
              active ? "bg-accent" : "bg-transparent",
            ]}
          />
        </a>
      );
    })
  }
</nav>
